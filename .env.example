# --- Database (used by docker-compose.yml's db service, and by the api container to connect to it) ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lenny_growth_assistant

# Host-side port Postgres is exposed on. Change if 5432 is already taken locally.
POSTGRES_PORT=5432

# Hostname the api container uses to reach Postgres. Leave as "db" (the
# Compose service name) — only change this if running the app outside Compose.
POSTGRES_HOST=db

# --- Embeddings (always local Ollama, regardless of LLM_PROVIDER — see architecture.md §6) ---
# host.docker.internal lets the api container reach Ollama running natively on
# the host machine (Docker Desktop only). On native Linux Docker, replace with
# the host's actual IP or run Ollama in a container on the same network.
OLLAMA_HOST=http://host.docker.internal:11434

# --- Chat/generation provider (architecture.md §6) ---
# "ollama" (default, no key required) or "claude" (requires ANTHROPIC_API_KEY below).
LLM_PROVIDER=ollama

# Only required when LLM_PROVIDER=claude. The app fails fast at startup if
# LLM_PROVIDER=claude and this is unset — never left to fail on first request.
ANTHROPIC_API_KEY=

# Local chat model for LLM_PROVIDER=ollama. Must support tool calling —
# verified empirically that llama3.2:3b does and gemma3:4b/phi3:3.8b do not
# (see architecture.md §6). Run `ollama pull llama3.2:3b` before starting.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Local model used only for ship30_essay's generation step (Phase 5) —
# deliberately different from OLLAMA_CHAT_MODEL. This call doesn't need tool
# calling, and llama3.2:3b measurably under-shoots the ~1,250-word essay
# target (~450-600 words); gemma3:4b reaches ~1,000-1,150 words at roughly
# half phi3:3.8b's latency (see agent-transcripts/README.md for the
# comparison). Run `ollama pull gemma3:4b` before starting.
OLLAMA_ESSAY_MODEL=gemma3:4b
